# Preserve the exact verified and downloadable generated bytes in Git.
* -text
# CSV and JSON writers use Windows CRLF; retain it without flagging CR as space.
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
